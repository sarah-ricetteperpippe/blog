---
// Box di iscrizione alla newsletter, mostrato in fondo a ogni pagina (vedi
// BaseLayout). Il form invia nome, email e lingua al webhook configurato in
// PUBLIC_NEWSLETTER_WEBHOOK.

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const base = (import.meta.env.BASE_URL as string).endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

const ui = {
  it: {
    title: 'Ricevi ricettine!',
    desc: 'Vuoi che condivida con te quando accade un (più unico che raro) miracolo nella mia cucina?',
    name: 'Il tuo nome',
    email: 'La tua email',
    cta: 'Condividi la gioia!',
    loading: 'Un attimo...',
    success: 'Che coraggio!',
    error: 'Qualcosa è andato storto. Riprova tra poco.',
    consentBefore: 'Ho letto e accetto l\'',
    consentLink: 'informativa privacy',
    consentAfter: ' per il trattamento di nome ed email ai fini della newsletter.',
    consentError: 'Devi accettare l\'informativa privacy per iscriverti.',
  },
  en: {
    title: 'Get little recipes!',
    desc: 'Want me to share with you when a (rare) kitchen miracle happens?',
    name: 'Your name',
    email: 'Your email',
    cta: 'Share the joy!',
    loading: 'Just a sec...',
    success: 'How brave!',
    error: 'Something went wrong. Please try again.',
    consentBefore: 'I have read and accept the ',
    consentLink: 'privacy notice',
    consentAfter: ' for the processing of my name and email to send me the newsletter.',
    consentError: 'You need to accept the privacy notice to subscribe.',
  },
  fr: {
    title: 'Reçois des petites recettes !',
    desc: 'Envie que je partage avec toi quand un miracle (rare) se produit dans ma cuisine ?',
    name: 'Ton prénom',
    email: 'Ton email',
    cta: 'Partager la joie !',
    loading: 'Un instant...',
    success: 'Quel courage !',
    error: 'Une erreur est survenue. Réessaie.',
    consentBefore: 'J\'ai lu et j\'accepte la ',
    consentLink: 'politique de confidentialité',
    consentAfter: ' pour le traitement de mon nom et de mon email dans le cadre de la newsletter.',
    consentError: 'Tu dois accepter la politique de confidentialité pour t\'inscrire.',
  },
} as const;

const t = ui[lang as keyof typeof ui] ?? ui.it;
---
<section class="newsletter-section js-reveal" id="newsletter">
  <div class="newsletter-inner">
    <div class="newsletter-card">
      <h2 class="newsletter-title">{t.title}</h2>
      <p class="newsletter-desc">{t.desc}</p>
      <form class="newsletter-form" id="newsletter-form" novalidate>
        <input type="text" name="nome" class="newsletter-input" placeholder={t.name} required autocomplete="given-name" />
        <input type="email" name="email" class="newsletter-input" placeholder={t.email} required autocomplete="email" />
        <label class="newsletter-consent">
          <input type="checkbox" name="consent" required />
          <span>{t.consentBefore}<a href={`${base}${lang}/privacy/`} target="_blank" rel="noopener noreferrer">{t.consentLink}</a>{t.consentAfter}</span>
        </label>
        <button
          type="submit"
          class="newsletter-btn"
          data-label={t.cta}
          data-loading={t.loading}
        >
          {t.cta}
        </button>
      </form>
      <p
        class="newsletter-feedback"
        id="newsletter-feedback"
        aria-live="polite"
        data-ok={t.success}
        data-err={t.error}
        data-consent-err={t.consentError}
      ></p>
    </div>
    <div class="newsletter-image">
      <img src={`${base}images/ricette/newsletter-subs-section.webp`} alt="" loading="lazy" />
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const feedback = document.getElementById('newsletter-feedback') as HTMLElement | null;
  const WEBHOOK = import.meta.env.PUBLIC_NEWSLETTER_WEBHOOK;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const MSG_OK = feedback?.dataset.ok ?? 'Che coraggio!';
  const MSG_ERR = feedback?.dataset.err ?? 'Qualcosa è andato storto. Riprova tra poco.';
  const MSG_CONSENT_ERR = feedback?.dataset.consentErr ?? MSG_ERR;
  const BTN_LABEL = submitBtn?.dataset.label ?? 'Condividi la gioia!';
  const BTN_LOADING = submitBtn?.dataset.loading ?? '...';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!WEBHOOK) {
      if (feedback) {
        feedback.textContent = MSG_ERR;
        feedback.className = 'newsletter-feedback newsletter-feedback--err';
      }
      return;
    }
    const data = Object.fromEntries(new FormData(form));
    // Il form ha novalidate: il controllo required del checkbox non blocca
    // nativamente l'invio, quindi verifichiamo il consenso qui prima di
    // contattare il webhook.
    if (!data.consent) {
      if (feedback) {
        feedback.textContent = MSG_CONSENT_ERR;
        feedback.className = 'newsletter-feedback newsletter-feedback--err';
      }
      return;
    }
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = BTN_LOADING;
    try {
      const res = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nome: data.nome, email: data.email, lang: document.documentElement.lang || 'it' }),
      });
      if (res.ok || res.status === 200) {
        form.style.display = 'none';
        if (feedback) { feedback.textContent = MSG_OK; feedback.className = 'newsletter-feedback newsletter-feedback--ok'; }
      } else {
        throw new Error('Non-OK response');
      }
    } catch {
      if (feedback) { feedback.textContent = MSG_ERR; feedback.className = 'newsletter-feedback newsletter-feedback--err'; }
      btn.disabled = false;
      btn.textContent = BTN_LABEL;
    }
  });
</script>
